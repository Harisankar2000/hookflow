# Local development values. They match docker-compose.yml.
DATABASE_URL=postgresql://hookflow:hookflow@localhost:5434/hookflow?schema=public
REDIS_URL=redis://localhost:6381
PORT=3100

# Required in the x-admin-token header to create a tenant.
ADMIN_TOKEN=dev-admin-token

# Delivery behaviour
MAX_ATTEMPTS=6
RETRY_BASE_MS=5000
RETRY_MAX_MS=3600000
DELIVERY_TIMEOUT_MS=10000
CIRCUIT_BREAKER_THRESHOLD=20
